# Copy this file to ".env" in the project root (the folder with
# package.json) and fill in the keys you have. ".env" is gitignored —
# never commit it, and never paste a key into chat or an issue.
#
# Only set the key for the feature you are running:
# - XAI_API_KEY is for Grok TTS cue-audio generation (Fix 2).
# - META_MODEL_API_KEY is for live cue-plan generation (still a stub).
# `npm test` needs neither key — the tests use local providers/mocks.

XAI_API_KEY=
META_MODEL_API_KEY=
